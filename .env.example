# ===========================================
# eSIM Platform - Environment Variables
# ===========================================

# Server
NODE_ENV=development
PORT=9000

# Database
DATABASE_URL=mysql://eims:secret123@localhost:3307/eims

# JWT Authentication
AUTH_JWT_SECRET=your-super-secret-key-change-in-production
AUTH_JWT_EXPIRATION_INTERVAL=3600
AUTH_JWT_AUDIENCE=esim.platform
AUTH_JWT_ISSUER=esim.platform

# Password Hashing (Argon2)
AUTH_HASH_LENGTH=32
AUTH_HASH_TIME_COST=6
AUTH_HASH_MEMORY_COST=65536
AUTH_MAX_DELAY=1000

# Logging
LOG_DISABLED=false
LOG_LEVELS=["log","error","warn"]

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
# Set EMAIL_ENABLED=true to enable email sending
# When disabled, emails are logged but not sent

EMAIL_ENABLED=false

# SMTP Server Settings
# For Gmail: smtp.gmail.com (port 587)
# For Outlook: smtp.office365.com (port 587)
# For Mailtrap (testing): sandbox.smtp.mailtrap.io (port 2525)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# SMTP Credentials
# For Gmail: Use an App Password (not your regular password)
# https://myaccount.google.com/apppasswords
EMAIL_USER=emadatef40@gmail.com
EMAIL_PASS=0597236632

# Sender Info
EMAIL_FROM=emadatef40@gmail.com
EMAIL_FROM_NAME=eSIM Platform

# ===========================================
# JAWWAL PAY AUTOMATIC PAYMENT VERIFICATION
# ===========================================
# See docs/PAYMENT_VERIFICATION.md

# Currency of the plans / wallet (Jawwal Pay notifications are in ILS)
PAYMENT_CURRENCY=ILS
# Wallet the customers transfer to (shown by GET /api/payments/instructions)
PAYMENT_WALLET_NUMBER=0599000000
PAYMENT_WALLET_NAME=Wallet owner name
# Only transfers received in the last N hours can be matched to an order
PAYMENT_MATCH_WINDOW_HOURS=72
# Accept transfers larger than the order amount
PAYMENT_ALLOW_OVERPAYMENT=true
# Max claim submissions per order before the customer must contact support
PAYMENT_MAX_CLAIM_ATTEMPTS=10
# Secret for POST /api/payments/notifications (header: x-payment-secret)
PAYMENT_WEBHOOK_SECRET=change-me-long-random-string

# Read the Jawwal Pay notification e-mails from Gmail over IMAP
# (Gmail App Password: https://myaccount.google.com/apppasswords)
PAYMENT_MAIL_ENABLED=false
PAYMENT_MAIL_HOST=imap.gmail.com
PAYMENT_MAIL_PORT=993
PAYMENT_MAIL_USER=
PAYMENT_MAIL_PASS=
PAYMENT_MAIL_MAILBOX=INBOX
# Optional filters (IMAP FROM / SUBJECT contains)
PAYMENT_MAIL_FROM_FILTER=
PAYMENT_MAIL_SUBJECT_FILTER=
PAYMENT_MAIL_POLL_INTERVAL_SECONDS=60
PAYMENT_MAIL_MARK_SEEN=true
